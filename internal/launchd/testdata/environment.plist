<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/worker</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>WORKER_STATUS_FILE</key>
		<string>/Users/me/Library/Application Support/worker/status.json</string>
		<key>WORKER_QUIET</key>
		<string></string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/me/Library/Logs/worker.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/me/Library/Logs/worker.err.log</string>
</dict>
</plist>
